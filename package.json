{
  "name": "github-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "verify": "pnpm run verify:static && pnpm run verify:test && pnpm run verify:build",
    "verify:static": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run arch:check && pnpm run deps:check",
    "verify:test": "pnpm run test:unit && pnpm run test:component",
    "verify:build": "pnpm -r --filter './apps/*' run build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "tsc --build && pnpm -r --if-present run typecheck",
    "arch:check": "depcruise --config .dependency-cruiser.cjs apps",
    "arch:graph": "mkdir -p artifacts && depcruise --config .dependency-cruiser.cjs --output-type dot apps > artifacts/dependency-graph.dot",
    "verify:guardrails": "node scripts/verify-guardrails.mjs",
    "deps:check": "knip && syncpack lint",
    "test:unit": "pnpm -r run test:unit",
    "test:component": "pnpm --filter @ghd/web run test:component",
    "test:e2e": "pnpm --filter @ghd/e2e run test",
    "dev": "docker compose --profile dev up --build",
    "dev:down": "docker compose --profile dev down -v",
    "stack:prod-like": "docker compose --profile prod-like up --build",
    "adr:new": "node scripts/new-adr.mjs",
    "changelog": "node scripts/generate-changelog.mjs",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "24.19.1",
    "dependency-cruiser": "18.5.0",
    "husky": "9.1.7",
    "knip": "6.41.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "syncpack": "15.3.3",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md}": "oxfmt",
    "*.{ts,tsx}": "oxlint --fix"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
