{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/web": {
      "entry": ["src/main.tsx", "tests/**/*.test.tsx"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"],
      "ignoreFiles": ["tests/determinism.ts"]
    },
    "e2e": {
      "entry": ["tests/**/*.spec.ts"],
      "project": ["tests/**/*.ts"]
    }
  }
}
