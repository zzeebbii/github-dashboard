{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/testing": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/api": {
      "entry": ["src/main.ts", "scripts/*.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/main.tsx", "tests/**/*.test.tsx"],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}"]
    },
    "e2e": {
      "entry": ["tests/**/*.spec.ts"],
      "project": ["tests/**/*.ts"]
    }
  },
  "ignoreDependencies": ["pino-pretty"]
}
