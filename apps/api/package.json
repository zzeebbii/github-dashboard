{
  "name": "@kit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "build": "tsc --build tsconfig.build.json",
    "start": "node dist/main.js",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "contract:generate": "node scripts/generate-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@kit/contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@kit/testing": "workspace:*",
    "@testcontainers/postgresql": "12.2.0",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
