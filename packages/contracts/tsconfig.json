{
  // TOOLING config: covers EVERY file, emits nothing.
  // This is the tsconfig editors and oxlint's type-aware rules discover, so it
  // must include tests — otherwise type-aware linting silently degrades to
  // "error" types on every test file and stops catching anything there.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "*.config.ts"]
}
