{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Solution-style root: `tsc --build` compiles every EMITTING project in
  // dependency order. Each package also has a tsconfig.json (no emit) that
  // covers tests — that is the one editors and oxlint discover.
  "files": [],
  "references": [
    { "path": "./packages/contracts/tsconfig.build.json" },
    { "path": "./packages/testing/tsconfig.build.json" },
    { "path": "./apps/api/tsconfig.build.json" },
    { "path": "./apps/web/tsconfig.build.json" }
  ]
}
