# Copy to .env and adjust. Every variable here is parsed and validated by Zod at
# process start (apps/api/src/config/env.ts). A missing or malformed value fails
# fast with a message naming the variable — it will never fail lazily at request time.

# --- Backend ---------------------------------------------------------------
# Node environment. One of: development | test | production
NODE_ENV=development

# Port the API listens on.
API_PORT=3000

# PostgreSQL connection string.
# Matches the `db` service in compose.yaml for local development.
DATABASE_URL=postgres://kit:kit@localhost:5432/kit

# Log level. One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Comma-separated list of origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# --- Frontend --------------------------------------------------------------
# Only VITE_-prefixed variables are exposed to the browser bundle.
# Never put a secret behind a VITE_ prefix — it ships to every user.
VITE_API_URL=http://localhost:3000
