{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "react-hooks", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",

    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/require-await": "error",

    "react/react-in-jsx-scope": "off",

    "no-console": "error",
    "eqeqeq": ["error", "always"],
    "no-restricted-globals": [
      "error",
      {
        "name": "process",
        "message": "Read configuration through the validated config module, not process.env. See docs/conventions/validation.md."
      }
    ]
  },
  "overrides": [
    {
      // Build tooling and config, not application code. These legitimately read
      // process.env and print to stdout — that is their entire job.
      "files": [
        "apps/api/src/config/env.ts",
        "apps/api/src/main.ts",
        "**/scripts/**",
        "**/*.config.ts",
        "**/*.config.js",
        "**/*.config.mjs"
      ],
      "rules": { "no-restricted-globals": "off", "no-console": "off" }
    },
    {
      // Plain JavaScript with no type annotations: every value is implicitly
      // `any`, so the type-aware "unsafe" family reports the language rather
      // than a defect. These scripts are covered by their own behaviour in CI.
      "files": ["**/scripts/**/*.mjs"],
      "rules": {
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-condition": "off"
      }
    },
    {
      // CSS and polyfill imports have no bindings by design.
      "files": ["apps/web/src/main.tsx"],
      "rules": { "import/no-unassigned-import": "off" }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/tests/**", "e2e/**"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        // Constructing a branded id in a fixture (`'...' as TaskId`) is the
        // intended idiom — the brand exists precisely so production code cannot
        // do this accidentally, while tests state it explicitly.
        "typescript/no-unsafe-type-assertion": "off",
        "vitest/no-focused-tests": "error",
        "vitest/no-disabled-tests": "warn",
        "vitest/expect-expect": "error"
      }
    },
    {
      "files": ["apps/api/src/domain/**", "apps/api/src/application/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/infrastructure/**",
                  "**/http/**",
                  "hono",
                  "hono/*",
                  "drizzle-orm",
                  "drizzle-orm/*"
                ],
                "message": "The core must not depend on infrastructure, HTTP, or the ORM. Define a port in application/ and bind the adapter in http/composition.ts. See docs/conventions/dependency-rules.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["zod", "zod/*", "@kit/contracts", "**/infrastructure/**", "**/http/**"],
                "message": "domain/ must be dependency-free. Zod guards boundaries; the type system guards the core. Use branded types and private constructors."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@kit/api", "@kit/api/*", "../../api/**", "**/apps/api/**"],
                "message": "The frontend must never import backend code. Use @kit/contracts and the HTTP wire. This rule is what keeps the backend replaceable."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/contracts/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["!zod", "!zod/*", "!./*", "!../*"],
                "message": "packages/contracts may import Zod only. It stays publishable and language-neutral."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/dist-types/**",
    "**/coverage/**",
    "**/node_modules/**",
    "apps/api/drizzle/**",
    "artifacts/**",
    "**/routeTree.gen.ts"
  ]
}
