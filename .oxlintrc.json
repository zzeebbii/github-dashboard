{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "react-hooks", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",

    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/require-await": "error",

    "react/react-in-jsx-scope": "off",

    "no-console": "error",
    "eqeqeq": ["error", "always"],
    "no-restricted-globals": [
      "error",
      {
        "name": "process",
        "message": "Read configuration through the validated config module, not process.env. See docs/conventions/validation.md."
      }
    ]
  },
  "overrides": [
    {
      // Build tooling and config, not application code. These legitimately read
      // process.env and print to stdout — that is their entire job.
      "files": ["**/scripts/**", "**/*.config.ts", "**/*.config.js", "**/*.config.mjs"],
      "rules": { "no-restricted-globals": "off", "no-console": "off" }
    },
    {
      // Plain JavaScript with no type annotations: every value is implicitly
      // `any`, so the type-aware "unsafe" family reports the language rather
      // than a defect. These scripts are covered by their own behaviour in CI.
      "files": ["**/scripts/**/*.mjs"],
      "rules": {
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unnecessary-condition": "off"
      }
    },
    {
      // CSS and side-effect imports (env validation) have no bindings by design.
      "files": ["apps/web/src/main.tsx"],
      "rules": { "import/no-unassigned-import": "off" }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/tests/**", "e2e/**"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        // Constructing a branded id in a fixture (`'...' as TaskId`) is the
        // intended idiom — the brand exists precisely so production code cannot
        // do this accidentally, while tests state it explicitly.
        "typescript/no-unsafe-type-assertion": "off",
        "vitest/no-focused-tests": "error",
        "vitest/no-disabled-tests": "warn",
        "vitest/expect-expect": "error"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/dist-types/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/routeTree.gen.ts",
    // Vendor design export (static HTML/JS reference, not our source).
    "docs/pr-dashboard-designs/**"
  ]
}
